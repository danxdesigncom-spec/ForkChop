# ForkChop environment variables
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never put real values in this file — it is
# committed, and only variable NAMES belong here.

# ---------------------------------------------------------------- Supabase
#
# BROWSER-SAFE. Both are NEXT_PUBLIC_ and are sent to the client on purpose.
# The anon key is a public project identifier, not a secret: it grants nothing
# on its own because every table is protected by row-level security keyed on
# auth.uid().
#
# Dashboard → Project Settings → API
#
# Leave both unset and the app still runs, signed out, saving to localStorage.
NEXT_PUBLIC_SUPABASE_URL=

# Newer Supabase projects issue a publishable key (sb_publishable_...); older
# ones issue an anon JWT. Either works — set whichever your project shows under
# Project Settings → API. The publishable name is preferred if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Supabase *service role* key bypasses row-level security entirely, so it
# must never be added as NEXT_PUBLIC_ and never reaches the browser. Only the
# admin backend (/admin, gated by NEXT_PUBLIC_FEATURE_ADMIN) reads this: it
# needs elevated auth to list every user, create users, and disable users.
# Leave unset to run without admin capabilities.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin. Case-insensitive, extra
# whitespace tolerated. Server-only — not NEXT_PUBLIC_ — because it is the
# authorisation gate; leaking it to the browser would let someone rewrite it.
# Empty (or unset) means nobody is admin; the /admin routes return 404.
ADMIN_EMAILS=

# The canonical origin magic-link emails should send users back to. Pin this
# in Production and Preview to your public domain (e.g. https://fork-chop.vercel.app)
# so email links never land on preview-only URLs guarded by Vercel Deployment
# Protection. Leave unset locally — the request headers are used as a fallback,
# which gives http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Database
#
# SERVER-ONLY. Optional. Where the bundled recipe corpus is seeded to.
# Serverless hosts are detected automatically and use the OS temp directory,
# so this normally does not need setting.
# FORKCHOP_DB_PATH=

# ------------------------------------------------------------ Spoonacular
#
# SERVER-ONLY. Note the deliberate absence of a NEXT_PUBLIC_ prefix: that is
# what stops Next.js inlining it into the browser bundle. The browser reaches
# Spoonacular only through /api/recommendations, which acts as the proxy.
#
# Sign up at https://spoonacular.com/food-api/console#Dashboard
# Free tier is 50 points per day. Our query shape costs about 1.85 points for
# 10 full recipes, so roughly 27 searches a day before the quota is spent —
# which is why Spoonacular is only consulted when local results are thin, and
# why responses are cached for 10 minutes.
#
# Unset, the app searches only its own 60 bundled recipes — no error, no
# degraded UI, just a smaller catalogue.
SPOONACULAR_API_KEY=

# ------------------------------------------------------- Feature flags
#
# BROWSER-SAFE. Every flag ships to the client, which is the point: server
# and client render off the same values, so nothing hydrates differently
# from what the server sent.
#
# Truthy: true, 1, on, yes  (any casing, whitespace tolerated)
# Falsy:  false, 0, off, no  (empty and anything else falls to the default)
#
# All flags below default to `true` — the features they gate are the intended
# experience. Leave a var unset (or empty) to accept the default. Set it to
# `false` in Vercel to take a feature back out without a code revert if it
# starts misbehaving. See src/lib/flags.ts.
#
NEXT_PUBLIC_FEATURE_KROGER=
NEXT_PUBLIC_FEATURE_INSTACART=
NEXT_PUBLIC_FEATURE_RATINGS=
NEXT_PUBLIC_FEATURE_ABOUT_PAGE=
NEXT_PUBLIC_FEATURE_PRIVACY_PAGE=
NEXT_PUBLIC_FEATURE_STAPLES_PAGE=
NEXT_PUBLIC_FEATURE_SAVED_GROUPING=
NEXT_PUBLIC_FEATURE_PAGINATION=
# Admin backend at /admin. Off by default. Requires ADMIN_EMAILS and
# SUPABASE_SERVICE_ROLE_KEY (both server-only, documented below).
NEXT_PUBLIC_FEATURE_ADMIN=

# ---------------------------------------------------------------- Grocery
#
# SERVER-ONLY. Optional. Without this the Instacart checkout option appears
# but reports itself as not connected.
# INSTACART_API_KEY=
#
# --- Kroger -----------------------------------------------------------
#
# SERVER-ONLY. All optional — Kroger works as a plain deep link with none of
# them set. Each tier adds capability:
#
#   CLIENT_ID + CLIENT_SECRET + LOCATION_ID -> estimated prices per line item
#   ... + REDIRECT_URI                      -> "add to my Kroger cart" handoff
#
# Register an app at https://developer.kroger.com to get the id and secret.
# Rate limits: products 10,000/day, cart 5,000/day.
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
#
# The store whose shelf prices are quoted. Kroger returns NO price without
# one, because prices are per-store. Find yours with
#   GET https://api.kroger.com/v1/locations?filter.zipCode.near=<your zip>
# KROGER_LOCATION_ID=
#
# Where Kroger sends the shopper back after they approve the cart handoff.
# Must exactly match the redirect URI registered on your Kroger app.
# Defaults to <NEXT_PUBLIC_SITE_URL>/api/kroger/callback when unset.
#
# NOTE: pushing items into a shopper's cart needs the `cart.basic:write`
# scope, which Kroger grants per-app on their developer portal. Without that
# approval the consent step fails and the UI falls back to the deep link.
# KROGER_REDIRECT_URI=
#
# Which storefront to use when the client doesn't name one. Unset, the app
# prefers Kroger (deep-links without any API key) and otherwise falls back to
# whichever provider is registered first.
# FORKCHOP_GROCERY_PROVIDER=kroger
